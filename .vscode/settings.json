{
  "editor.rulers": [100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": "always",
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.renderLineHighlight": "all",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.linkedProjects": ["Cargo.toml", "fuzz/Cargo.toml"],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferGoToSourceDefinition": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/bun.lock": true,
    "**/Cargo.lock": true,
    "**/src/generated": true,
    "**/mutants.out*": true,
    "fixtures/**/*.json": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/target": true,
    "**/graft": true,
    "**/.turbo": true,
    "**/mutants.out*": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, turbo.json, tsconfig*.json",
    "Cargo.toml": "Cargo.lock, rust-toolchain.toml, rustfmt.toml, clippy.toml, deny.toml",
    "README.md": "LICENSE",
    ".gitignore": ".ignore",
    "CONTRIBUTING.md": "CODE_OF_CONDUCT.md, SECURITY.md, PULL_REQUEST_TEMPLATE.md",
    "lib.rs": "verification.rs",
    "ramadan.rs": "ramadan_table.rs"
  },
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 16,
  "npm.packageManager": "bun",
  "git.branchProtection": [],
  "git.branchProtectionPrompt": "alwaysCommit"
}
