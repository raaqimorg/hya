{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/generated/**",
        "../../tsconfig.json",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "../../rust-toolchain.toml",
        "../../crates/engine/Cargo.toml",
        "../../crates/engine/src/**",
        "../../crates/wasm/Cargo.toml",
        "../../crates/wasm/src/**"
      ],
      "outputs": ["dist/**", "src/generated/**", "LICENSE", "README.md"]
    },
    "types": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
